#!/usr/bin/env python3
import argparse

def main():
    parser = argparse.ArgumentParser(description="Simple parameter output demo for knowledge_search")

    parser.add_argument("agent_id", type=str, help="The word type you want to print, e.g. 'Noun' or 'Verb'")
    parser.add_argument("task_description", type=str, required=True,
                        help="Comma-separated words to output, e.g. 'Multiple logarithms,Single logarithm'")

    args = parser.parse_args()

    print("=== knowledge_search parameters ===")
    print(f"agent_id : {args.agent_id}")
    print(f"task_description: {args.task_description}")

if __name__ == "__main__":
    main()
