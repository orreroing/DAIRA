#!/usr/bin/env python3
import argparse

def main():
    parser = argparse.ArgumentParser(description="Simple parameter output demo for knowledge_search")

    parser.add_argument("command", type=str, help="The word type you want to print, e.g. 'Noun' or 'Verb'")
    parser.add_argument("--key_word", type=str, required=True,
                        help="Comma-separated words to output, e.g. 'Multiple logarithms,Single logarithm'")

    args = parser.parse_args()

    print("=== knowledge_search parameters ===")
    print(f"command : {args.command}")
    print(f"key_word: {args.key_word}")

if __name__ == "__main__":
    main()
